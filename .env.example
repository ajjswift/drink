# Square — copy to .env.local for development, and set the same keys in Railway.
# Never commit real values: .env* files are gitignored.

# Access token for the Square account that owns the menu.
# Square Dashboard -> Developer -> Applications -> your app -> Credentials.
# Use the Production token with SQUARE_ENVIRONMENT=production.
SQUARE_ACCESS_TOKEN=

# The Square category that holds the Cocktails category.
SQUARE_MENU_ID=6VC47G3IED5AQRMUTNCLSMY5

# "production" (default) or "sandbox".
SQUARE_ENVIRONMENT=production

# Optional: pin a Square API version, e.g. 2025-01-23. Leave unset to use the
# default version for the Square account.
SQUARE_API_VERSION=

# Redis is used only in production to cache the Square catalog between requests.
# Railway's Redis service exposes this as REDIS_URL; leave it blank locally.
REDIS_URL=

# Optional cache lifetime in seconds. Defaults to one hour.
SQUARE_MENU_CACHE_TTL_SECONDS=3600
